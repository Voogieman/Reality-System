POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=magic13_local
TYPEORM_SYNCHRONIZE=true
APP_BASE_URL=http://localhost:3000

# JWT auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# AI (ProxyAPI / OpenAI-compatible)
OPENAI_API_KEY=your_proxyapi_key
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=900
OPENAI_ORACLE_TEMPERATURE=0.88

# Email (статусы ритуалов и подтверждение круга)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Велес <noreply@localhost>

# Telegram bot (вход в ЛК и уведомления)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
